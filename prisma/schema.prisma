generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY
  MEMBER
}

enum ProfileSection {
  BASIC
  FINANCIAL
  STRATEGY
  HR
  CONTACT
}

enum ProjectMode {
  SINGLE
  MULTI
}

enum ProjectStatus {
  WAITING_FOR_FORM
  ANALYSIS_PENDING
  AI_PROCESSING
  REVIEWING
  CHAT_MODE
  FINAL_ANALYSIS
  FAILED
}

enum NotificationType {
  PROJECT_ACCESS_GRANTED
  FOLLOW_UP_ANSWERED
}

enum QuestionType {
  CHECKBOX
  RADIO
  NUMBER
  TEXT
}

enum FollowUpStatus {
  PENDING
  ANSWERED
}

enum PromptOwnerType {
  ANALYSIS_FORM
  MULTI_ANALYSIS_FORM
}

enum PromptVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompanyDataModel {
  COMPANY_BASIC_INFO
  COMPANY_MANAGER
  REVENUE_CENTER
  COMPANY_SHAREHOLDER
  ORGANIZATION_UNIT
  COMPANY_LICENSE_CERTIFICATE
  COMPANY_MEMBERSHIP
  COMPANY_PRODUCT_SERVICE
  COMPANY_MARKET
  KEY_CUSTOMER
  COMPANY_BALANCE_SHEET
  COMPANY_INCOME_STATEMENT
  COMPANY_RESOURCE_CAPABILITY
  COMPANY_SUPPLIER
  COMPANY_RAW_MATERIAL
}

enum Region {
  IRAN
  INTERNATIONAL
}

enum TargetMarketType {
  PRIMARY
  INDIVIDUAL
}

//////
enum StrategyFramework {
  BSC
  OKR
}

enum StrategyStatus {
  DRAFT
  IN_PROGRESS
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StrategyState {
  MAP_GENERATION
  MAP_VALIDATION

  KPI_GENERATION
  KPI_VALIDATION

  TABLE_GENERATION
  TABLE_VALIDATION

  READY_FOR_MONITORING
  MONITORING

  FAILED
}

enum StrategyMapStatus {
  DRAFT
  VALIDATING
  APPROVED
}

enum StrategyMeasureStatus {
  DRAFT
  VALIDATING
  APPROVED
}

enum StrategyMonitoringStatus {
  DRAFT
  LOCKED
}

enum MeasurementFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BscPerspective {
  FINANCIAL
  CUSTOMER
  INTERNAL_PROCESS
  LEARNING_GROWTH
}

enum LearningGrowthCategory {
  HUMAN_CAPITAL
  INFORMATION_CAPITAL
  ORGANIZATIONAL_CAPITAL
}

enum StrategyApprovalType {
  MAP
  MEASURES
}
/////



model User {
  id              String           @id @default(uuid())
  username        String           @unique
  password        String
  email           String?          @unique
  phoneNumber     String?          @unique
  role            Role
  companyId       String?
  progress        Json?
  projectComments ProjectComment[]

  userInfo        UserInfo?
  educations      UserEducation[]
  trainingCourses UserTrainingCourse[]
  competencies    UserCompetency[]

  profileCompleted Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  uploadedFiles    FileAttachment[]

  company             Company?               @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  createdProjects     Project[]
  ratingHistory       ProjectRatingHistory[]
  profileViewAccesses ProfileViewAccess[]
  chatMessages        ChatMessage[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  projectAccesses     ProjectAccess[]
  followUpRequests    FollowUpRequest[]      @relation("UserFollowUpRequests")
  answeredFollowUps   FollowUpRequest[]      @relation("AdminAnsweredFollowUps")
  bookmarkedProjects  ProjectBookmark[]

  strategyMapsApproved       StrategyMap[]              @relation("StrategyMapApprovedBy")
  strategyMeasuresOwned      StrategyMeasure[]          @relation("StrategyMeasureOwner")
  strategyMeasuresApproved   StrategyMeasure[]          @relation("StrategyMeasureApprovedBy")
  strategyMeasurementsSubmitted StrategyMeasureMeasurement[] @relation("StrategyMeasurementSubmittedBy")

  @@index([role])
  @@index([companyId])
}

model UserInfo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String
  nationalCode        String
  jobTitle            String
  birthDate           DateTime?
  lastJobTitle        String
  organizationalLevel String

  isboardMember        Boolean @default(false)
  isshareholder        Boolean @default(false)
  isstrategyTeamMember Boolean @default(false)
}

model UserEducation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  degree         String?
  fieldOfStudy   String?
  specialization String?
  graduationYear Int?
  university     String?

  sortOrder Int?

  @@index([userId])
}

model UserTrainingCourse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseName String
  level      String?
  hours      Int?
  provider   String?
  date       DateTime?

  sortOrder Int?

  @@index([userId])
}

model UserCompetency {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  competencyName String

  type          String?
  expectedLevel String?
  currentLevel  String?

  jobRelevance String?
  importance   String?

  sortOrder Int @default(0)

  @@index([userId])
  @@index([userId, sortOrder])
}

model ProfileViewAccess {
  id        String         @id @default(uuid())
  userId    String
  companyId String
  section   ProfileSection
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([companyId])
}

model CompanyAdminData {
  id        String   @id @default(uuid())
  companyId String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Project {
  id        String        @id @default(uuid())
  title     String  @db.Text
  creatorId String
  companyId String?
  mode      ProjectMode   @default(SINGLE)
  status    ProjectStatus @default(WAITING_FOR_FORM)

  formResponses       Json?
  formId              String?
  multiAnalysisFormId String?
  promptVersionId     String?
  comments            ProjectComment[]
  chatMessages        ChatMessage[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  creator             User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  company             Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form                AnalysisForm?      @relation(fields: [formId], references: [id], onDelete: Cascade)
  multiAnalysisForm   MultiAnalysisForm? @relation(fields: [multiAnalysisFormId], references: [id], onDelete: Cascade)
  promptVersion       PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  domain              String?            @db.Text
  
  initialAnalysis     String?            @db.Text
  finalAnalysis       String?            @db.Text
  summaryAnalysis     String?             @db.Text
  riskPercentage      Float?

  riskAnalysis        String?            @db.Text
  keyStrategicInsights String?   @db.Text


  ratings          ProjectRatingHistory[]
  accesses         ProjectAccess[]
  goals            ProjectGoal[]
  multiGoals       ProjectMultiGoal[]
  followUpRequests FollowUpRequest[]

  averageRating  Float   @default(0)
  ratingCount    Int     @default(0)
  hasRating      Boolean @default(false)

  chatModeStartedAt    DateTime?
  chatModeEndedAt      DateTime?

  selectedSourceProjects MultiAnalysisProjectSource[] @relation("MultiProjectSources")
  usedInMultiProjects    MultiAnalysisProjectSource[] @relation("SourceProjectUsedInMulti")
  bookmarks              ProjectBookmark[]
  strategyPlans StrategyPlan[]

  @@index([status])
  @@index([companyId])
  @@index([formId])
  @@index([multiAnalysisFormId])
  @@index([promptVersionId])
}

model ProjectBookmark {
  id String @id @default(uuid())

  userId    String
  projectId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectComment {
  id      String @id @default(uuid())
  content String @db.Text

  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectRatingHistory {
  id        String   @id @default(uuid())
  projectId String
  raterId   String
  score     Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rater     User     @relation(fields: [raterId], references: [id])

  @@unique([projectId, raterId])
  @@index([projectId])
  @@index([raterId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String
  userId    String?
  role      String // "user" | "assistant" | "system"
  content   String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model AnalysisCategory {
  id          String              @id @default(uuid())
  title       String
  description String?              @db.Text
  image       String?
  order       Int?                 @default(0)
  forms       AnalysisForm[]
  multiForms  MultiAnalysisForm[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([order])
}

model AnalysisForm {
  id                      String                       @id @default(uuid())
  title                   String
  info                    String?                     @db.Text
  order                   Int?
  isActive                Boolean                      @default(true)
  categoryId              String?
  category                AnalysisCategory?            @relation(fields: [categoryId], references: [id])
  categories              FormQuestionCategory[]
  goals                   FormGoal[]
  promptDefinition        PromptDefinition?
  projects                Project[]
  requiredInMultiAnalysis MultiAnalysisRequiredForm[]
  multiProjectSources     MultiAnalysisProjectSource[]
  profileFields           AnalysisFormProfileField[]
  temperature             Float                        @default(0.7)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  featuredAnalysis        FeaturedAnalysis?
  categoryGroups          FormCategoryGroup[]
  checklistTitle          String?

  @@index([isActive])
  @@index([order])
  @@index([categoryId])
}

model FormQuestionCategory {
  id String @id @default(uuid())

  title String
  order Int    @default(0)

  analysisFormId String?
  analysisForm   AnalysisForm? @relation(fields: [analysisFormId], references: [id], onDelete: Cascade)

  multiAnalysisFormId String?
  multiAnalysisForm   MultiAnalysisForm? @relation(fields: [multiAnalysisFormId], references: [id], onDelete: Cascade)

  parentId String?
  parent   FormQuestionCategory?  @relation("QuestionCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FormQuestionCategory[] @relation("QuestionCategoryTree")

  questions FormQuestion[]

  groups FormCategoryGroupItem[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisFormId])
  @@index([multiAnalysisFormId])
  @@index([parentId])
}

model FormQuestion {
  id String @id @default(uuid())

  categoryId String
  category   FormQuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  label String   @db.Text

  type QuestionType

  required Boolean @default(true)

  order Int

  isScored Boolean @default(false)

  weight Int?

  options FormQuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormQuestionOption {
  id String @id @default(uuid())

  questionId String
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label String  @db.Text
  value String

  score Int?

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model FormCategoryGroup {
  id String @id @default(uuid())

  analysisFormId String?
  analysisForm   AnalysisForm? @relation(fields: [analysisFormId], references: [id], onDelete: Cascade)

  multiAnalysisFormId String?
  multiAnalysisForm   MultiAnalysisForm? @relation(fields: [multiAnalysisFormId], references: [id], onDelete: Cascade)

  title String @db.Text

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories FormCategoryGroupItem[]

  @@index([analysisFormId])
  @@index([multiAnalysisFormId])
}

model FormCategoryGroupItem {
  id String @id @default(uuid())

  groupId String
  group   FormCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  categoryId String
  category   FormQuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([groupId, categoryId])
}

model FeaturedAnalysis {
  id             String       @id @default(uuid())
  analysisFormId String       @unique
  analysisForm   AnalysisForm @relation(fields: [analysisFormId], references: [id])
  createdAt      DateTime     @default(now())
}

model FormGoal {
  id        String        @id @default(uuid())
  formId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  projects  ProjectGoal[]
  form      AnalysisForm  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model ProjectGoal {
  id        String   @id @default(uuid())
  projectId String
  goalId    String
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal    FormGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([projectId, goalId])
  @@index([projectId])
  @@index([goalId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  message       String  @db.Text
  isRead        Boolean          @default(false)
  referenceId   String?
  referenceType String?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ProjectAccess {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model MultiAnalysisRequiredForm {
  id                  String @id @default(uuid())
  multiAnalysisFormId String
  formId              String
  order               Int

  multiAnalysisForm MultiAnalysisForm @relation(fields: [multiAnalysisFormId], references: [id], onDelete: Cascade)
  form              AnalysisForm      @relation(fields: [formId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([multiAnalysisFormId, formId])
  @@index([multiAnalysisFormId, order])
  @@index([formId])
}

model MultiAnalysisProjectSource {
  id              String   @id @default(uuid())
  multiProjectId  String
  sourceProjectId String
  formId          String
  createdAt       DateTime @default(now())

  multiProject  Project      @relation("MultiProjectSources", fields: [multiProjectId], references: [id], onDelete: Cascade)
  sourceProject Project      @relation("SourceProjectUsedInMulti", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  form          AnalysisForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([multiProjectId, formId])
  @@index([multiProjectId])
  @@index([sourceProjectId])
  @@index([formId])
}

model MultiAnalysisForm {
  id             String            @id @default(uuid())
  title          String
  description    String?           @db.Text
  isActive       Boolean           @default(true)
  order          Int?
  checklistTitle String?
  categoryId     String?
  category       AnalysisCategory? @relation(fields: [categoryId], references: [id])

  requiredForms    MultiAnalysisRequiredForm[]
  goals            MultiAnalysisGoal[]
  projects         Project[]
  promptDefinition PromptDefinition?
  profileFields    MultiAnalysisFormProfileField[]
  categories       FormQuestionCategory[]
  categoryGroups   FormCategoryGroup[]

  temperature Float @default(0.7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@index([categoryId])
}

model MultiAnalysisGoal {
  id                  String   @id @default(uuid())
  multiAnalysisFormId String
  title               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projects          ProjectMultiGoal[]
  multiAnalysisForm MultiAnalysisForm  @relation(fields: [multiAnalysisFormId], references: [id], onDelete: Cascade)

  @@unique([multiAnalysisFormId, title])
  @@index([multiAnalysisFormId])
}

model ProjectMultiGoal {
  id        String   @id @default(uuid())
  projectId String
  goalId    String
  createdAt DateTime @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal    MultiAnalysisGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([projectId, goalId])
  @@index([projectId])
  @@index([goalId])
}

model FollowUpForm {
  id          String  @id @default(uuid())
  title       String
  description String?
  isActive    Boolean @default(true)
  order       Int?

  questions FollowUpFormQuestion[]
  requests  FollowUpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model FollowUpFormQuestion {
  id       String       @id @default(uuid())
  formId   String
  label    String
  type     QuestionType
  options  Json?
  required Boolean      @default(true)
  order    Int

  form FollowUpForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, order])
}

model FollowUpRequest {
  id String @id @default(uuid())

  title  String
  status FollowUpStatus @default(PENDING)

  projectId String
  userId    String
  formId    String?

  responses Json

  adminAnswer  String?   @db.Text
  answeredAt   DateTime?
  answeredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User          @relation("UserFollowUpRequests", fields: [userId], references: [id], onDelete: Cascade)
  form       FollowUpForm? @relation(fields: [formId], references: [id], onDelete: Cascade)
  answeredBy User?         @relation("AdminAnsweredFollowUps", fields: [answeredById], references: [id], onDelete: Cascade)

  extraDescription String? @db.Text

  @@index([projectId])
  @@index([userId])
  @@index([formId])
  @@index([status])
  @@index([createdAt])
  @@index([title])
}

model PromptDefinition {
  id                  String          @id @default(uuid())
  ownerType           PromptOwnerType
  title               String?
  analysisFormId      String?         @unique
  multiAnalysisFormId String?         @unique

  analysisForm      AnalysisForm?      @relation(fields: [analysisFormId], references: [id])
  multiAnalysisForm MultiAnalysisForm? @relation(fields: [multiAnalysisFormId], references: [id])

  segments PromptSegmentDefinition[]
  versions PromptVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptSegmentDefinition {
  id                 String  @id @default(uuid())
  promptDefinitionId String
  key                String
  label              String
  description        String?
  sortOrder          Int?
  isRequired         Boolean @default(false)

  promptDefinition PromptDefinition            @relation(fields: [promptDefinitionId], references: [id])
  values           PromptVersionSegmentValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promptDefinitionId, key])
  @@index([promptDefinitionId, sortOrder])
}

model PromptVersion {
  id                 String              @id @default(uuid())
  promptDefinitionId String
  versionNumber      Int
  versionKey         String
  status             PromptVersionStatus
  publishedAt        DateTime?

  promptDefinition PromptDefinition            @relation(fields: [promptDefinitionId], references: [id])
  values           PromptVersionSegmentValue[]
  projects         Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promptDefinitionId, versionNumber])
  @@unique([promptDefinitionId, versionKey])
}

model PromptVersionSegmentValue {
  id                  String @id @default(uuid())
  promptVersionId     String
  segmentDefinitionId String
  content             String @db.Text

  promptVersion     PromptVersion           @relation(fields: [promptVersionId], references: [id])
  segmentDefinition PromptSegmentDefinition @relation(fields: [segmentDefinitionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promptVersionId, segmentDefinitionId])
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  industry String?  @db.Text
  chatMessageLimit Int @default(10)

  members             User[]                      @relation("CompanyMembers")
  profileViewAccesses ProfileViewAccess[]
  companyAdminData    CompanyAdminData?
  projects            Project[]
  userLimit           Int                         @default(1)
  basicInfo           CompanyBasicInfo?
  managers            CompanyManager[]
  revenueCenters      RevenueCenter[]
  shareholders        CompanyShareholder[]
  organizationUnits   OrganizationUnit[]
  licenseCertificates CompanyLicenseCertificate[]
  memberships         CompanyMembership[]
  insight             CompanyInsight?

  productServices CompanyProductService[]
  markets         CompanyMarket[]
  keyCustomers    KeyCustomer[]

  balanceSheets    CompanyBalanceSheet[]
  incomeStatements CompanyIncomeStatement[]
  keySuppliers     CompanySupplier[]
  rawMaterials     CompanyRawMaterial[]

  resourceCapabilities CompanyResourceCapability[]

  strategyPlans StrategyPlan[]
}

model CompanyBasicInfo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId                   String  @unique
  company                     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandTitle                  String?   @db.Text
  knownAs                     String?   @db.Text
  nationalId                  String?
  isPublicCompany             Boolean @default(false)
  isHolding                   Boolean @default(false)
  isHoldingSubsidiary         Boolean @default(false)
  establishmentYear           String?
  commercialActivityStartYear String?
  parentCompanyName           String?
  totalPersonnelCount         Int?
  operationalPersonnelCount   Int?
  phoneNumber                 String?
  website                     String?
  vision                      String? @db.Text
  objectives                  String? @db.Text
  region                      Region?
}

model CompanyManager {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fullName              String
  positionTitle         String?
  isBoardMember         Boolean?
  isStrategyTeamMember  Boolean?
  companyWorkExperience Int?
  totalWorkExperience   Int?

  resumeFileId String?
  resumeFile   FileAttachment? @relation(fields: [resumeFileId], references: [id], onDelete: Cascade)

  sortOrder Int?

  @@index([companyId])
  @@index([resumeFileId])
}

model RevenueCenter {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                    String
  activityYearsCount       Int?
  totalRevenueSharePercent Decimal? @db.Decimal(5, 2)
  lastYearEstimatedRevenue Decimal? @db.Decimal(20, 0)
  personnelCount           Int?
  sortOrder                Int?

  @@index([companyId])
}

model CompanyShareholder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name              String
  shareholderType   String?
  isBoardMember     Boolean?
  hasPreferredShare Boolean?
  sharePercent      Decimal? @db.Decimal(5, 2)

  @@index([companyId])
}

model OrganizationUnit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
