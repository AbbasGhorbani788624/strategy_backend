///

model StrategyPlan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  framework StrategyFramework

  status StrategyStatus @default(DRAFT)
  state  StrategyState  @default(MAP_GENERATION)

  strategyText String? @db.Text

  companyProfile Json?

  maps       StrategyMap[]
  objectives StrategyObjective[]
  measures   StrategyMeasure[]

  aiRuns     StrategyAiRun[]
  approvals  StrategyApproval[]

  @@index([projectId])
  @@index([companyId])
  @@index([framework])
  @@index([status])
  @@index([state])
}

model StrategyMap {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategyPlanId String
  strategyPlan   StrategyPlan @relation(fields: [strategyPlanId], references: [id], onDelete: Cascade)

  version Int @default(1)

  status StrategyMapStatus @default(DRAFT)

  /**
   * اولین خروجی AI
   */
  initialData Json?

  /**
   * آخرین داده‌ای که کاربر ویرایش کرده
   */
  editedData Json?

  /**
   * خروجی نهایی بعد از validation
   */
  finalData Json?

  approvedAt DateTime?

  approvedById String?
  approvedBy User? @relation("StrategyMapApprovedBy", fields: [approvedById], references: [id],onDelete: SetNull)

  objectives StrategyObjective[]

  @@index([strategyPlanId])
  @@index([status])
}

model StrategyObjective {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategyPlanId String
  strategyPlan   StrategyPlan @relation(fields: [strategyPlanId], references: [id], onDelete: Cascade)

  mapId String?
  map   StrategyMap? @relation(fields: [mapId], references: [id], onDelete: Cascade)
  code String?

  title       String
  description String? @db.Text

  perspective BscPerspective?

  learningGrowthCategory LearningGrowthCategory?

  priority Int?

  sortOrder Int @default(0)

  /**
   * Hierarchy
   */
  parentId String?

  parent StrategyObjective? @relation("StrategyObjectiveHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children StrategyObjective[] @relation("StrategyObjectiveHierarchy")

  outgoingRelations StrategyObjectiveRelation[] @relation("StrategyObjectiveRelationFrom")

  incomingRelations StrategyObjectiveRelation[] @relation("StrategyObjectiveRelationTo")

  measures StrategyMeasure[]

  @@index([strategyPlanId])
  @@index([mapId])
  @@index([perspective])
  @@index([parentId])
}

model StrategyObjectiveRelation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  fromObjectiveId String
  toObjectiveId   String

  fromObjective StrategyObjective @relation("StrategyObjectiveRelationFrom", fields: [fromObjectiveId], references: [id], onDelete: Cascade)

  toObjective StrategyObjective @relation("StrategyObjectiveRelationTo", fields: [toObjectiveId], references: [id], onDelete: Cascade)

  @@unique([fromObjectiveId, toObjectiveId])
  @@index([fromObjectiveId])
  @@index([toObjectiveId])
}

model StrategyMeasure {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategyPlanId String
  strategyPlan   StrategyPlan @relation(fields: [strategyPlanId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   StrategyObjective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  /**
   * نام سنجه
   */
  name String

  /**
   * توضیح سنجه
   */
  description String? @db.Text

  /**
   * ریال، تومان، درصد، عدد، روز و...
   */
  unit String?

  /**
   * روزانه، هفتگی، ماهانه و...
   */
  frequency MeasurementFrequency?

  /**
   * مقدار پایه
   */
  baseline Decimal? @db.Decimal(20, 4)

  /**
   * Target نهایی دوره
   */
  finalTarget Decimal? @db.Decimal(20, 4)

  /**
   * فرمول سنجه (از KPI table)
   */
  formula String? @db.Text

  /**
   * تاریخ شروع پایش
   */
  monitoringStartDate DateTime?

  /**
   * مدت پایش به ماه
   */
  monitoringDurationMonths Int?

  /**
   * وضعیت Planning / Monitoring
   */
  monitoringStatus StrategyMonitoringStatus?

  ownerId String?

  owner User? @relation("StrategyMeasureOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  status StrategyMeasureStatus @default(DRAFT)

  approvedAt DateTime?

  approvedById String?

  approvedBy User? @relation("StrategyMeasureApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  targets      StrategyMeasureTarget[]
  measurements StrategyMeasureMeasurement[]

  @@index([strategyPlanId])
  @@index([objectiveId])
  @@index([ownerId])
  @@index([status])
}

model StrategyMeasureTarget {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measureId String

  measure StrategyMeasure @relation(fields: [measureId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  periodLabel String?

  targetValue Decimal? @db.Decimal(20, 4)

  @@unique([measureId, periodStart, periodEnd])
  @@index([measureId])
  @@index([periodStart, periodEnd])
}

model StrategyMeasureMeasurement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measureId String

  measure StrategyMeasure @relation(fields: [measureId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  actualValue Decimal @db.Decimal(20, 4)

  note String? @db.Text

  submittedById String?

  submittedBy User? @relation("StrategyMeasurementSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())

  @@unique([measureId, periodStart, periodEnd])
  @@index([measureId])
  @@index([periodStart, periodEnd])
}

model StrategyAiRun {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  strategyPlanId String

  strategyPlan StrategyPlan @relation(fields: [strategyPlanId], references: [id], onDelete: Cascade)

  framework StrategyFramework
  state     StrategyState

  requestPayload Json

  responsePayload Json?

  success Boolean @default(false)

  errorMessage String? @db.Text

  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([strategyPlanId])
  @@index([state])
  @@index([success])
}

model StrategyApproval {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  strategyPlanId String

  strategyPlan StrategyPlan @relation(fields: [strategyPlanId], references: [id], onDelete: Cascade)

  type StrategyApprovalType

  version Int

  approvedAt DateTime @default(now())

  @@index([strategyPlanId])
  @@index([type])
}